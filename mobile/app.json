{
  "expo": {
    "name": "Cataract Screening",
    "slug": "cataract-screening",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is needed to capture front-of-eye images for cataract screening."
      }
    },
    "android": {
      "package": "com.andrea435.cataractscreening",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is needed to capture front-of-eye images for cataract screening.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}
